# files that run on the PS5 console (synced by tar from a Windows checkout): never CRLF
*.sh text eol=lf
*.service text eol=lf
*.conf text eol=lf
*.env text eol=lf
*.comp text eol=lf
*.glsl text eol=lf
# sources are LF in the repo and in every checkout (the console build reads a tar of the Windows working tree)
*.cpp text eol=lf
*.hpp text eol=lf
*.hip text eol=lf
*.py text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.pdf binary
*.bin binary
