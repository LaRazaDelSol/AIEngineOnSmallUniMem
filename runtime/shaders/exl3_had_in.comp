#version 460
// S15b EXL3 expert input transform: xt[e][m] = H128(x * suh_m) for gate (m=0) and up (m=1), 128-blocks.
// Grid (20 blocks, 2 mats, K experts), 128 threads. slots[e] == 0 -> this expert runs in the other overlap pass.
#include "exl3_common.glsl"
layout(local_size_x = 128) in;
layout(push_constant) uniform PC { uint64_t x; uint64_t slots; uint64_t xt; } pc;
shared float sh[128];

void main() {
    const uint i = gl_LocalInvocationID.x, b = gl_WorkGroupID.x, m = gl_WorkGroupID.y, e = gl_WorkGroupID.z;
    const uint64_t sa = U64(pc.slots).v[e];
    if (sa == 0ul) return;
    const uint n = b * 128u + i;
    float v = F32(pc.x).v[n] * float(H16(sa + (m == 0u ? OFF_G_SUH : OFF_U_SUH)).v[n]);
    sh[i] = v;
    barrier();
    [[unroll]] for (uint h = 1u; h < 128u; h <<= 1) {
        const float o = sh[i ^ h];
        barrier();
        v = (i & h) == 0u ? v + o : o - v;
        sh[i] = v;
        barrier();
    }
    F32(pc.xt).v[(e * 2u + m) * 2560u + n] = v * RSQRT128;
}
