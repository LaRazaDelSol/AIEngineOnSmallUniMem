#version 460
// Qwen4ExpTextRMSNorm with group_size G: out[g*G+i] = x[g*G+i] * rsqrt(mean_g(x^2) + eps) * (1 + w[g*G+i]).
// One workgroup (256) per group. Used for hc_norm, PLE norm_key/norm_query/norm_conv.
#include "common.glsl"
layout(local_size_x = 256) in;
layout(push_constant) uniform PC { uint64_t x; uint64_t w; uint64_t outp; uint G; float eps; } pc;
shared float part[8];
#ifdef GFIX
// S19: compile-time group size: both loops unroll (10 independent loads per thread instead of a latency chain),
// the per-thread sum keeps its order (s += t*t over i = tid, tid + 256, ...): bit-identical.
const uint GG = GFIX;
#else
#define GG pc.G
#endif
void main() {
    const uint g = gl_WorkGroupID.x, base = g * GG;
    F32 X = F32(pc.x), Wt = F32(pc.w), O = F32(pc.outp);
    float s = 0.0;
    [[unroll]] for (uint i = gl_LocalInvocationID.x; i < GG; i += 256u) { float t = X.v[base + i]; s += t * t; }
    s = subgroupAdd(s);
    if (gl_SubgroupInvocationID == 0u) part[gl_SubgroupID] = s;
    barrier();
    float tot = 0.0;
    for (uint i = 0u; i < gl_NumSubgroups; ++i) tot += part[i];
    const float inv = inversesqrt(tot / float(GG) + pc.eps);
    [[unroll]] for (uint i = gl_LocalInvocationID.x; i < GG; i += 256u) O.v[base + i] = X.v[base + i] * inv * (1.0 + Wt.v[base + i]);
}
