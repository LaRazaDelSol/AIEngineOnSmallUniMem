#version 460
// S15 fused hyper-connection pre-step, part 2 (replaces matvec(up, sigmoid) + hc_mix):
//   sig[c*H+i] = sigmoid(up[c*H+i] . t)          (rank-320 up projection, 4 stream rows per output i)
//   x[i]       = mean_c sig[c*H+i] * normed[c*H+i]
//   inj[c]     = 2 * sigmoid(injl[c] / C)        (only if pc.injl != 0)
// One wave per output i computes its 4 rows, so `sig` never goes to memory. Bit-exact with the 2-kernel path:
// each row uses matvec.comp's lane/word order (K = 320 -> 40 words, lanes 40..63 idle as before), and the mix sums
// c = 0..3 in hc_mix.comp's order.
#define BITS 4
#include "common.glsl"
layout(local_size_x = 256) in;
layout(push_constant) uniform PC { uint64_t w; uint64_t t; uint64_t normed; uint64_t xout; uint64_t injl; uint64_t inj; } pc;
const uint H = 2560u, C = 4u, KU = 320u;
void main() {
    const uint lane = gl_SubgroupInvocationID;
    const uint i = gl_WorkGroupID.x * gl_NumSubgroups + gl_SubgroupID;
    const uint SW = scale_words(KU), RW = row_words(KU), QW = quant_words(KU);
    U32 W = U32(pc.w);
    V4 X = V4(pc.t);
    float sig[4];
    [[unroll]] for (uint c = 0u; c < C; ++c) {
        const uint rb = (c * H + i) * RW;
        float acc = 0.0;
        for (uint w = lane; w < QW; w += 64u) {
            float xv[16];
            float sx;
            load_x(X, w, xv, sx);
            acc += block_scale(W, rb, w) * word_dot(W.v[rb + SW + w], xv, sx);
        }
        acc = subgroupAdd(acc) * 1.0;
        sig[c] = 1.0 / (1.0 + exp(-acc));
    }
    if (lane == 0u && i < H) {
        F32 Nn = F32(pc.normed);
        float a = 0.0;
        [[unroll]] for (uint c = 0u; c < C; ++c) a += sig[c] * Nn.v[c * H + i];
        F32(pc.xout).v[i] = a / float(C);
    }
    if (pc.injl != 0ul && gl_WorkGroupID.x == 0u && gl_LocalInvocationID.x < C)
        F32(pc.inj).v[gl_LocalInvocationID.x] = 2.0 / (1.0 + exp(-F32(pc.injl).v[gl_LocalInvocationID.x] / float(C)));
}
