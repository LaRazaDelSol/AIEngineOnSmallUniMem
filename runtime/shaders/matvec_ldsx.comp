#version 460
// S19: dense PS5Q4 matvec for LARGE K (10240: hyper-connection down + inject) with x staged in LDS once per workgroup
// (4 waves), rows r = wg*rpw + wave, +4, ...; each row's IT quant + scale words loaded back to back as uniform row
// base + 32-bit lane offset + immediate (saddr form).
// Optional second matrix (w2 != 0): rows N..N+N2-1 are W2's rows 0..N2-1 -> y2 with mode2 / alpha2 (the HC inject
// rows ride in the down dispatch instead of a 1-workgroup dispatch of their own).
// BIT-IDENTICAL to matvec.comp: lane `lane` handles words w = lane + 64 it in ascending order, x of a word is the same
// two vec4, sx = (x0+x1+x2+x3) + (x4+..+x7) (load_x), s = sum_v qval*x in v order (word_dot),
// acc += scale * (s - 8 sx), then the same subgroupAdd.
#define BITS 4
#include "common.glsl"
#ifndef KDIM
#define KDIM 10240
#endif
layout(local_size_x = 256) in;
layout(push_constant) uniform PC {
    uint64_t w; uint64_t x; uint64_t y; uint K; uint N; uint rpw; uint mode; float alpha; uint N2;
    uint64_t w2; uint64_t y2; uint mode2; float alpha2;
} pc;
shared vec4 xs[KDIM / 4];
const uint QW = (KDIM / 32u) * QWPB;
const uint IT = QW / 64u;
const uint SW = (((KDIM / 32u) * 2u + 15u) & ~15u) >> 2;
const uint RW = (((SW * 4u) + QW * 4u + 15u) & ~15u) >> 2;

uint64_t row_addr(uint r) {
    return r < pc.N ? pc.w + uint64_t(r) * uint64_t(RW * 4u) : pc.w2 + uint64_t(r - pc.N) * uint64_t(RW * 4u);
}
void main() {
    const uint lane = gl_SubgroupInvocationID, wave = gl_SubgroupID;
    const uint qoff = (SW + lane) * 4u, soff = (lane >> 3) * 4u;
    const uint NT = pc.N + (pc.w2 != 0ul ? pc.N2 : 0u);
    const uint r0 = gl_WorkGroupID.x * pc.rpw;
    // (fetching the first row before the barrier is SLOWER: ACO waits for every outstanding load at barrier())
    [[unroll]] for (uint i = gl_LocalInvocationID.x; i < KDIM / 4u; i += 256u) xs[i] = V4(pc.x + uint64_t(i * 16u)).v[0];
    barrier();
    for (uint rr = wave; rr < pc.rpw; rr += gl_NumSubgroups) {
        const uint r = r0 + rr;
        if (r >= NT) break;
        uint q[IT], sw[IT];
        const uint64_t rp = row_addr(r);
        [[unroll]] for (uint it = 0u; it < IT; ++it) {
            q[it] = U32(rp + uint64_t(qoff + 256u * it)).v[0];
            sw[it] = U32(rp + uint64_t(soff + 32u * it)).v[0];
        }
        float acc = 0.0;
        [[unroll]] for (uint it = 0u; it < IT; ++it) {
            const uint w = lane + 64u * it;
            const uint b = w >> 2, j = w & 3u;
            const vec4 lo = xs[b * 8u + j], hi = xs[b * 8u + 4u + j];
            float sx = 0.0;
            sx += lo.x + lo.y + lo.z + lo.w;
            sx += hi.x + hi.y + hi.z + hi.w;
            const uint qq = q[it];
            float s = 0.0;
            s += qval(qq, 0u) * lo.x; s += qval(qq, 1u) * lo.y; s += qval(qq, 2u) * lo.z; s += qval(qq, 3u) * lo.w;
            s += qval(qq, 4u) * hi.x; s += qval(qq, 5u) * hi.y; s += qval(qq, 6u) * hi.z; s += qval(qq, 7u) * hi.w;
            const vec2 s2 = unpackHalf2x16(sw[it]);
            const float bs = ((w / QWPB) & 1u) != 0u ? s2.y : s2.x;
            acc += bs * (s - ZERO * sx);
        }
        const bool second = r >= pc.N;
        acc = subgroupAdd(acc) * (second ? pc.alpha2 : pc.alpha);
        if (lane == 0u) {
            const uint md = second ? pc.mode2 : pc.mode;
            F32 Y = F32(second ? pc.y2 : pc.y);
            const uint ri = second ? r - pc.N : r;
            float o = acc;
            if (md == 2u) o = acc / (1.0 + exp(-acc));
            else if (md == 3u) o = 1.0 / (1.0 + exp(-acc));
            if (md == 1u) Y.v[ri] += o; else Y.v[ri] = o;
        }
    }
}
