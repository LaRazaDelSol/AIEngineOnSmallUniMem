# Copy to scripts/console.env (git-ignored) and edit. Read by every scripts/ps5-*.sh that runs on the PC.
PS5_HOST=steam@192.168.1.50        # your console (a wired NIC is faster for bulk transfers, ~110 MB/s)
PS5_KEY=.ssh/ps5_ed25519           # relative to the repo root
PS5_ROOT='~/ps5lm'                 # console-side tree: src/ (synced), build14/ (serving build), model/, bench/
PS5_BUILD='~/ps5lm/build14'        # the build directory ps5lm-server.service starts the engine from
